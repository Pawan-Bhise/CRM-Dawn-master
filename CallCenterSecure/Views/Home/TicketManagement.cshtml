                $("#SPParameterValue").append("<option value='IndivName'>IndivName</option>");
                $("#SPParameterValue").append("<option value='IndivID'>IndivID</option>");
                $("#SPParameterValue").append("<option value='IndivFon'>IndivFon</option>");

