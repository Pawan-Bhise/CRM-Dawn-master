</style>
<script>
    $(document).ready(function () {


        var type = $("#hdnCallType").val();
        var searchid = $("#hdnSearchID").val();
        var searchfor = $("#hdnSearchFor").val();
        var phonenumber = $("#hdnPhoneNumber").val();
        var branchname = $("#hdnBranchName").val();

        if (type != null && type != "") {
            $("#TypeOfCall").val(type);
            typeofcallChangeFiled();
        }
        if (searchid != null && searchid != "") {
            $("#SPParameterValue").val(searchid);
        }
        if (searchfor != null && searchfor != "") {
            $("#ClientIdSearch").val(searchfor);
        }

        if (branchname != null && branchname != "") {
            $("#SearchBranch").val(branchname);
        }

        if ($("#TypeOfCall").val() == "GLClients") {
            $("#gl-client").show();
        }

        $(document).on("change", "#TypeOfCall", function () {

            clearallautofield();
            typeofcallChangeFiled();
        });

        function typeofcallChangeFiled() {
            $("#SPParameterValue").html("");

            if ($("#TypeOfCall").val() == "GLClients") {

                $("#SPParameterValue").append("<option value='GroupID'>GroupID</option>");
                $("#SPParameterValue").append("<option value='CollPtNr'>CollPtNr</option>");
                $("#SPParameterValue").append("<option value='GrpLdrName'>GrpLdrName</option>");
                $("#SPParameterValue").append("<option value='GrpLdrFon'>GrpLdrFon</option>");

                $("#gl-client").show();
                $("#all-il-clients").hide();
                $("#il-clients").hide();
                $("#vsa-clients").hide();

            }
            else if ($("#TypeOfCall").val() == "AllILClients") {

                $("#SPParameterValue").append("<option value='IndivName'>IndivName</option>");
                $("#SPParameterValue").append("<option value='IndivID'>IndivID</option>");
                $("#SPParameterValue").append("<option value='IndivFon'>IndivFon</option>");

                $("#gl-client").hide();
                $("#all-il-clients").show();
                $("#il-clients").hide();
                $("#vsa-clients").hide();
            }
            else if ($("#TypeOfCall").val() == "ILClients") {

                $("#SPParameterValue").append("<option value='IndivName'>IndivName</option>");
                $("#SPParameterValue").append("<option value='IndivID'>IndivID</option>");
                $("#SPParameterValue").append("<option value='IndivFon'>IndivFon</option>");

                $("#gl-client").hide();
                $("#all-il-clients").hide();
                $("#il-clients").show();
                $("#vsa-clients").hide();
            }
