<input type='hidden' value='@Request.QueryString["Type"]' id='hdnCallType' />
<input type='hidden' value='@Request.QueryString["SearchID"]' id='hdnSearchID' />
<input type='hidden' value='@Request.QueryString["SearchFor"]' id='hdnSearchFor' />
