@model CallCenter.Models.RegistrationViewModel

@{
    ViewBag.Title = "UserList";
}
<script src="~/Scripts/jquery-3.3.1.js"></script>
 
<h2>User Management</h2>

<p>
    <div class="row padingtop-bottom20px">
        <div class="col-md-12">
            @*<input type="submit" value="Apply" class="btn btn-primary" />
                <input type="button" id="btnDownladExcel" class="btn btn-primary" value="Download Excel" style="float:right" />*@
            <input type="button" name="btnCreateTicket" class="btn btn-primary" value="Register User" style="float:right" onclick="window.location= '@Url.Action("Registration", "Admin")'" />
        </div>
    </div>
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayName("User Name")
        </th>
        <th>
            @Html.DisplayName("First Name")
        </th>
        <th>
            @Html.DisplayName("Last Name")
        </th>
        <th>
            @Html.DisplayName("Email")
        </th>
        <th>
            @Html.DisplayName("Role")
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.UsersList)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                @Html.ActionLink("Edit", "UserEdit", new { id = item.UserId }) |
                @Html.ActionLink("Reset Password", "ResetPassword", "Home", new { id = item.UserId }, new { @class = "userresetpassword" }) |
                <a href='javascript:;' onclick='showDelete(@item.UserId);'>Delete </a>
            </td>
        </tr>
    }

</table>




<script type="text/javascript">

        function showDelete(userid) {
             if (confirm("Are you sure you want to delete this?")) {

                 $.ajax(
                    {
                        url: '/Admin/UserDelete?id=' + userid,
                        type: 'GET',
                        data: "",
                        contentType: 'application/json; charset=utf-8',
                         success: function (data) {
                            location.reload();
                            alert("User deleted successfully!!");
                            
                        },
                        error: function () {
                            alert("error");
                        }
                    });
            }
            else {
                return false;
            }
        }
 
</script>





